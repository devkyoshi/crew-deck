{
  "name": "@crew-deck/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts up",
    "db:rollback": "tsx --env-file=../../.env src/db/migrate.ts down",
    "db:seed": "tsx --env-file=../../.env src/db/seed.ts"
  },
  "dependencies": {
    "@crew-deck/shared": "workspace:^",
    "bullmq": "^6.3.14",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
}
