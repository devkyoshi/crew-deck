{
  "name": "@crew-deck/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/db/seed.ts",
    "db:seed:demo": "tsx --env-file=../../.env src/db/seed-demo.ts",
    "db:platform-admin": "tsx --env-file=../../.env src/db/create-platform-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3",
    "@aws-sdk/lib-storage": "3",
    "@crew-deck/shared": "workspace:^",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^9",
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/argon2": "^2.2.2",
    "@socket.io/redis-emitter": "5",
    "bullmq": "^6.3.14",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "fractional-indexing": "^4.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "mongodb": "^6",
    "socket.io": "4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@socket.io/redis-adapter": "8",
    "@types/node": "^26.6.5",
    "socket.io-client": "4",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  },
  "exports": {
    "./realtime": "./src/realtime-api.ts"
  }
}
