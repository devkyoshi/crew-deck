{
  "name": "crew-deck",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @crew-deck/api --filter @crew-deck/realtime --filter @crew-deck/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @crew-deck/api db:migrate",
    "db:seed": "pnpm --filter @crew-deck/api db:seed",
    "db:seed:demo": "pnpm --filter @crew-deck/api db:seed:demo",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.64.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "mongodb": "^6",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
