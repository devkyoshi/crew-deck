# Postgres. APP role is restricted (RLS applies); ADMIN role owns the schema and runs migrations/seed.
POSTGRES_USER=crew_admin
POSTGRES_PASSWORD=crew_admin_dev
POSTGRES_DB=crewdeck
POSTGRES_PORT=5433
REDIS_PORT=6380
DATABASE_URL=postgres://crew_app:crew_app_dev@localhost:5433/crewdeck
DATABASE_ADMIN_URL=postgres://crew_admin:crew_admin_dev@localhost:5433/crewdeck
APP_ROLE_PASSWORD=crew_app_dev
REDIS_URL=redis://localhost:6380

API_PORT=4000
API_HOST=0.0.0.0
LOG_LEVEL=info
NEXT_PUBLIC_API_URL=http://localhost:4000

# Tenancy: each workspace lives at <slug>.BASE_DOMAIN. *.localhost works in browsers with no setup.
BASE_DOMAIN=localhost
WEB_ORIGIN=http://localhost:3000
TENANT_ORIGIN_TEMPLATE=http://{slug}.localhost:3000
# Web -> API proxy target (read at web build/start)
API_INTERNAL_URL=http://localhost:4000

# Google SSO (optional). Redirect URI to register: <WEB_ORIGIN>/api/v1/auth/sso/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email via Brevo (optional). Without BREVO_API_KEY, invite links are logged and shown to admins instead.
# EMAIL_FROM_ADDRESS must be a sender verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Crew Deck
INVITE_TTL_DAYS=7

# Sign-in attempts per client+email per minute (default 10). Raise locally so the Playwright suite,
# which signs in many times a minute, is not rate limited. Keep the default in production.
# AUTH_RATE_LIMIT_MAX=300
