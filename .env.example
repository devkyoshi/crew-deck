# MongoDB (single-node replica set, see docker-compose.yml). directConnection is needed from the host.
MONGO_PORT=27018
MONGODB_URI=mongodb://localhost:27018/?directConnection=true
MONGODB_DB=crewdeck
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

API_PORT=4000
API_HOST=0.0.0.0
LOG_LEVEL=info
NEXT_PUBLIC_API_URL=http://localhost:4000

# Tenancy: each workspace lives at <slug>.BASE_DOMAIN. *.localhost works in browsers with no setup.
BASE_DOMAIN=localhost
WEB_ORIGIN=http://localhost:3000
TENANT_ORIGIN_TEMPLATE=http://{slug}.localhost:3000
# Web -> API proxy target (read at web build/start)
API_INTERNAL_URL=http://localhost:4000

# Google SSO (optional). Redirect URI to register: <WEB_ORIGIN>/api/v1/auth/sso/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email via Brevo (optional). Without BREVO_API_KEY, invite links are logged and shown to admins instead.
# EMAIL_FROM_ADDRESS must be a sender verified in Brevo.
BREVO_API_KEY=
# Set to 'log' to never send email even with a key (browser tests): sign-up and invitation links are shown instead.
EMAIL_MODE=auto
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Crew Deck
INVITE_TTL_DAYS=7

# Sign-in attempts per client+email per minute (default 10). Raise locally so the Playwright suite,
# which signs in many times a minute, is not rate limited. Keep the default in production.
# AUTH_RATE_LIMIT_MAX=300

# Attachments. 'local' keeps files in STORAGE_DIR (relative to apps/api when run with pnpm dev).
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# Signs short-lived file links. Required in production and for the compose stack: 32+ random characters,
# for example from `openssl rand -base64 48`. Development falls back to a fixed value when empty.
STORAGE_SIGNING_SECRET=
